{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart",
    "log:default",
    "core:window:allow-destroy"
  ]
}
