<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Datenschutzmanifest für den Mac App Store.

  Chefsachen verfolgt niemanden: Alles bleibt lokal in der Datenbank im
  Container der App. Einzige Ausnahme sind die Straßenvorschläge, nach der
  Installation aus: Eingeschaltet geht der getippte Adresstext an Photon von
  komoot. Apple zählt Daten, die ein Dritter erhält, als erfasst. Deshalb
  steht hier die physische Adresse, nicht verknüpft, ohne Tracking, nur für
  die App-Funktion. Muss mit den Angaben in App Store Connect übereinstimmen
  (docs/store/checkliste.md).

  Begründet werden nur die Schnittstellen, die Apple als „required reason API"
  führt und die das Programm tatsächlich berührt:
  - Dateizeitstempel (C617.1): Die Liste der Sicherungen liest Dateiangaben
    über stat, und SQLite tut es für die eigene Datenbank. Apple zählt stat
    zu diesen Schnittstellen; berührt werden nur Dateien im eigenen Container.
  - UserDefaults (CA92.1): WebKit legt darin Einstellungen der eigenen App
    ab; das Programm selbst liest keine fremden Werte.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhysicalAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
